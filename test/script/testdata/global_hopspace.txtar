# A hub cloned with --global is marked (repo.mode = "global" in its
# hop.json) and keeps its hopspace in $GIT_HOP_DATA_HOME/<org>/<repo>; add,
# move and remove keep that hopspace current.
#
# The regression this pins: add and move tried the hub's own hop.json as
# the hopspace first. Any hub has one, so they always wrote there and the
# data-home hopspace stayed frozen at clone time, listing only the default
# branch.

exec git init --bare $WORK/org/repo.git
exec git clone $WORK/org/repo.git $WORK/seed
cd $WORK/seed
exec git commit --allow-empty -m 'initial'
exec git push origin main
cd $WORK

exec git-hop --global $WORK/org/repo.git hub
exists $WORK/data/org/repo/hop.json
decode json $WORK/hub/hop.json repo.mode global
cd $WORK/hub

# --- add registers the branch in the data-home hopspace ---
# The hopspace other --global hubs can share records it under its path.
exec git-hop add feat/x
grep '"[^"]*/hub/hops/feat/x": \{' $WORK/data/org/repo/hop.json
grep '"branch": "feat/x"' $WORK/data/org/repo/hop.json

# --- move rekeys it there ---
exec git-hop move feat/x feat/y
! grep '/hops/feat/x"' $WORK/data/org/repo/hop.json
grep '"[^"]*/hub/hops/feat/y": \{' $WORK/data/org/repo/hop.json
grep '"branch": "feat/y"' $WORK/data/org/repo/hop.json

# --- remove unregisters it there ---
exec git-hop remove feat/y --no-prompt
! grep '/hops/feat/y"' $WORK/data/org/repo/hop.json
grep '"[^"]*/hub/hops/main": \{' $WORK/data/org/repo/hop.json
