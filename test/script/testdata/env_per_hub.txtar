# Two hubs of one repository get environments that do not collide: each
# has its own compose override directory. An entry an earlier release
# wrote keeps the override it names, or the repository-wide one when it
# names none.
#
# A stub docker on PATH stands in for compose: `compose config` fails (so
# the raw compose file is parsed) and each `up` is logged with its
# arguments and directory.

mkdir $WORK/bin
cp $WORK/docker-stub $WORK/bin/docker
chmod 755 $WORK/bin/docker
env PATH=$WORK/bin${:}$PATH

exec git init --bare $WORK/org/repo.git
exec git clone $WORK/org/repo.git $WORK/seed
cd $WORK/seed
cp $WORK/compose.yml docker-compose.yml
exec git add docker-compose.yml
exec git commit -m 'compose'
exec git push origin main
cd $WORK

exec git-hop $WORK/org/repo.git $WORK/one/app
exec git-hop $WORK/org/repo.git $WORK/two/app

# --- each hub caches its override in its own directory ---
grep '"overrideDir": ".*/org/repo/app-[0-9a-f]{8}/main"' $WORK/one/app/ports.json
grep '"overrideDir": ".*/org/repo/app-[0-9a-f]{8}/main"' $WORK/two/app/ports.json
exec sh -c 'ls -d $WORK/.cache/git-hop/org/repo/app-*/main | wc -l'
stdout '^ *2$'

cd $WORK/one/app/hops/main
exec git-hop env start
cd $WORK/two/app/hops/main
exec git-hop env start
exec sh -c 'grep -o "\-f [^ ]*override.yml" $WORK/up.log | sort -u | wc -l'
stdout '^ *2$'

# --- an entry without an override directory uses the repository-wide one ---
cp $WORK/legacy-ports.json $WORK/two/app/ports.json
mkdir $WORK/.cache/git-hop/org/repo/main
cp $WORK/compose.yml $WORK/.cache/git-hop/org/repo/main/docker-compose.override.yml
exec git-hop env start
grep ' -f .*/.cache/git-hop/org/repo/main/docker-compose.override.yml .* in .*/two/app/hops/main$' $WORK/up.log

-- compose.yml --
services:
  web:
    image: nginx
    ports:
      - "8080:80"
-- legacy-ports.json --
{"allocationMode":"incremental","baseRange":{"start":10000,"end":20000},"branches":{"main":{"ports":{"WEB":10000}}},"services":["WEB"]}
-- docker-stub --
#!/bin/sh
case " $* " in
*" up "*)
	echo "up $* in $PWD" >> "$WORK/up.log"
	exit 0
	;;
*" config "*)
	exit 1
	;;
esac
exit 0
