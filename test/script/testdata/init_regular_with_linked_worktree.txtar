# A regular repository that has a linked worktree (`git worktree add`) is
# still a regular repository: git does not call it bare, and it is not a
# git-hop hub. `git hop init` offers to convert it rather than reporting a
# bare-worktree hub and registering it as-is. A bare conversion would
# disconnect the linked worktree from its repository, so it is refused
# before anything moves; --regular keeps .git in place and works.

exec git init $WORK/p
cd $WORK/p
exec git commit --allow-empty -m 'initial'
exec git worktree add -q $WORK/p-feat -b feat

# --- offered conversion, not "already initialized" ---
! exec git-hop init --no-prompt --no-hooks
stdout 'Current repository: Standard git repository'
! stdout 'already initialized'
! stdout 'Structure: bare-worktree'
stderr 'Conversion failed: linked worktrees present'
stdout 'linked worktree\(s\) \(.*/p-feat\)'

# --- refused before anything moved ---
exists $WORK/p/.git/config
! exists $WORK/p/hop.json
! exists $WORK/p/hops
exec git -C $WORK/p rev-parse --is-bare-repository
stdout '^false$'
exec git -C $WORK/p-feat status --short --branch
stdout '^## feat$'

# --- a regular conversion keeps the linked worktree working ---
exec git-hop init --no-prompt --no-hooks --regular
stdout 'Conversion successful'
exists $WORK/p/hop.json
exec git -C $WORK/p-feat status --short --branch
stdout '^## feat$'

# --- and a registered regular hub is recognised on the next run ---
exec git-hop init --no-prompt --no-hooks
stdout 'already initialized'
stdout 'Structure: worktree$'

# --- a real bare hub is still recognised ---
exec git init $WORK/b
cd $WORK/b
exec git commit --allow-empty -m 'initial'
exec git-hop init --no-prompt --no-hooks
stdout 'Conversion successful'
cd $WORK/b
exec git-hop init --no-prompt --no-hooks
stdout 'already initialized'
stdout 'Structure: bare-worktree$'
cd $WORK/b/hops/main
exec git-hop init --no-prompt --no-hooks
stdout 'already initialized'
stdout 'Structure: worktree-child$'
