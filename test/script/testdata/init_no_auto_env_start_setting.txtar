# `git hop init` does not write settings.autoEnvStart into the hub's
# hop.json. Nothing reads it there: whether add and clone start the
# environment is git config hop.env.autoStart (or GIT_HOP_AUTO_ENV_START,
# or --[no-]env-start), and a stray `true` in hop.json read as if it
# still promised an auto-start.

exec git init $WORK/proj
cd $WORK/proj
exec git commit --allow-empty -m 'initial'

exec git-hop init --no-prompt --no-hooks
exists $WORK/proj/hop.json
grep '"defaultBranch": "main"' $WORK/proj/hop.json
! grep 'autoEnvStart' $WORK/proj/hop.json
