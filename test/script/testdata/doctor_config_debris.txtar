# doctor finds the --global hop.* keys the zero-value global.json migration
# wrote and the user never set, and only doctor --fix unsets them.
#
# That migration wrote every scalar of GlobalConfig, so keys absent from
# global.json landed as false/0/"" and shadow the compiled defaults (e.g.
# hop.worktreeLocation "" selects the centralized layout). Evidence is
# global.json.bak, the file it read, plus the hop.migrated sentinel; a key
# is only touched while it still holds the value the migration wrote.
# Retired settings are not migration debris: doctor's retired-settings
# check warns about them and --fix unsets them whatever their value, even
# one global.json.bak shows the user chose (hop.backup.enabled here).
# git's global config here is $WORK/gitconfig (see the script setup).

mkdir $WORK/data $WORK/.config/git-hop $WORK/.cache/git-hop
cp $WORK/bak.json $WORK/.config/git-hop/global.json.bak
exec git config --global hop.migrated true
exec git config --global hop.gitDomain example.com
exec git config --global hop.backup.enabled false
exec git config --global hop.worktreeLocation ''
exec git config --global hop.shellIntegration.status ''
exec git config --global hop.backup.keepBackup false
exec git config --global hop.backup.maxBackups 5
exec git config --global hop.conversion.autoRollback false

# --- nothing happens on its own ---
exec git-hop list
exec git config --global --get hop.shellIntegration.status

# --- doctor reports each leftover as an issue with a fix hint ---
exec sh -c 'git-hop doctor --json; echo "exit=$?"'
stdout '^exit=1$'
stdout '"check": "config"'
stdout '"subject": "hop.shellIntegration.status"'
stdout '"subject": "hop.backup.keepBackup"'
stdout '"subject": "hop.worktreeLocation"'
stdout 'run ''git hop doctor --fix'' to unset it'
! stdout '"subject": "hop.gitDomain"'
! stdout '"subject": "hop.backup.maxBackups"'

# --- retired keys are warnings of the retired check, once each ---
! exec git-hop doctor --porcelain
stdout '^warning	config	hop.conversion.autoRollback	retired setting'
stdout '^warning	config	hop.backup.enabled	retired setting'
! stdout '^issue	config	hop.conversion.autoRollback'
! stdout '^issue	config	hop.backup.enabled'
exec sh -c 'git-hop doctor --porcelain | grep -c "	hop.conversion.autoRollback	"'
stdout '^1$'

# --- the preview changes nothing ---
exec git-hop doctor --fix --dry-run
exec git config --global --get hop.backup.keepBackup

# --- --fix unsets the leftovers and the retired keys, and keeps the
# --- user's live keys ---
exec git-hop doctor --fix
! exec git config --global --get hop.shellIntegration.status
! exec git config --global --get hop.backup.keepBackup
! exec git config --global --get hop.worktreeLocation
! exec git config --global --get hop.conversion.autoRollback
! exec git config --global --get hop.backup.enabled
exec git config --global --get hop.gitDomain
stdout example.com
exec git config --global --get hop.backup.maxBackups
exec git config --global --get hop.migrated
exec git-hop doctor

-- bak.json --
{"defaults": {"gitDomain": "example.com"}, "backup": {"enabled": false}}
