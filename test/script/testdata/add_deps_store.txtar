# add installs shared deps into the hopspace's store, <hopspace>/deps. A
# default hub is its own hopspace, so that is <hub>/deps however the hub
# path compares to the data home.
#
# The regression this pins: the store path was cut from the hopspace path
# at the data home's length without checking the hopspace was inside it,
# so a hub path longer than the data home got <data>/<tail of hub>/deps.
#
# A stub npm on PATH stands in for `npm ci`: it writes ./node_modules.

mkdir $WORK/bin
cp $WORK/npm-stub $WORK/bin/npm
chmod 755 $WORK/bin/npm
env PATH=$WORK/bin${:}$PATH

exec git init --bare $WORK/org/repo.git
exec git clone $WORK/org/repo.git $WORK/seed
cd $WORK/seed
cp $WORK/package.json package.json
cp $WORK/package.json package-lock.json
exec git add package.json package-lock.json
exec git commit -m 'npm'
exec git push origin main
cd $WORK

# --- hub path longer than the data home ---
exec git-hop $WORK/org/repo.git a-hub-path-longer-than-the-data-home
cd $WORK/a-hub-path-longer-than-the-data-home
exec git-hop add feat/x
exec readlink hops/feat/x/node_modules
stdout '/a-hub-path-longer-than-the-data-home/deps/node_modules\.[0-9a-f]{6}$'
exists hops/feat/x/node_modules/installed
exists deps/.registry.json
exec find $WORK/data -name deps
! stdout .

-- package.json --
{}
-- npm-stub --
#!/bin/sh
mkdir -p node_modules && echo ok > node_modules/installed
