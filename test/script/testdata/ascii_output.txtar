# Human output is plain ASCII, like git's: no check marks, arrows or
# box drawing on stdout or stderr.
#
# The regressions this pins: env gc and doctor prefixed their progress and
# result lines with Unicode check marks; list marked worktree state with
# check/cross glyphs and a glyph legend; status --all drew a box header,
# emoji section icons and a box-drawing tree.

exec git init --bare $WORK/org/repo.git
exec git clone $WORK/org/repo.git $WORK/seed
cd $WORK/seed
exec git commit --allow-empty -m 'initial'
exec git push origin main
cd $WORK
exec git-hop $WORK/org/repo.git hub
cd $WORK/hub
mkdir $WORK/data/git-hop $WORK/.config/git-hop $WORK/.cache/git-hop

# --- env gc with nothing to collect ---
exec git-hop env gc --no-prompt
stdout 'No orphaned dependencies found'
! stderr '[^\x00-\x7F]'
! stdout '[^\x00-\x7F]'

# --- env gc deleting an orphan ---
mkdir $WORK/hub/deps/node_modules.abc123
cp $WORK/registry.json $WORK/hub/deps/.registry.json
exec git-hop env gc --no-prompt
stdout 'Deleted 1 orphaned dependencies'
! stderr '[^\x00-\x7F]'
! stdout '[^\x00-\x7F]'

# --- doctor on a healthy hub ---
exec git-hop doctor
! stderr '[^\x00-\x7F]'
! stdout '[^\x00-\x7F]'

# --- list inside the hub, and across all repositories ---
exec git-hop list
stdout 'active'
! stderr '[^\x00-\x7F]'
! stdout '[^\x00-\x7F]'

cd $WORK
exec git-hop list
stdout 'All Repositories'
stdout 'Legend: active = worktree on disk, missing = worktree directory not found'
! stderr '[^\x00-\x7F]'
! stdout '[^\x00-\x7F]'

# --- status --all: plain header, sections and tree ---
exec git-hop status --all
stdout 'Git-Hop System Status'
stdout 'Configuration'
stdout '^    `- github.com/org/repo +1 worktrees  .*0 stopped'
! stderr '[^\x00-\x7F]'
! stdout '[^\x00-\x7F]'

-- registry.json --
{"entries":{"node_modules.abc123":{"lockfileHash":"abc123","lockfilePath":"package-lock.json","usedBy":[],"lastUsed":"2026-09-01T00:00:00Z","installedAt":"2026-09-01T00:00:00Z"}}}
