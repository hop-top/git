# A command line the CLI cannot parse is a usage error: git's status 129
# with a lowercase `error:` line on stderr, followed by the usage of the
# command reached, and nothing on stdout. Only a command that ran and
# failed exits 1.

# --- upstream repo + hub, so operation failures have somewhere to run ---
exec git init --bare $WORK/repo.git
exec git clone $WORK/repo.git $WORK/seed
cd $WORK/seed
exec git commit --allow-empty -m 'initial'
exec git push origin main
cd $WORK
exec git-hop $WORK/repo.git hub
cd $WORK/hub

# --- unknown long flag, on the root and on a subcommand ---
exec sh -c 'git-hop --no-such-flag; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unknown flag: --no-such-flag\nusage: git hop \[<options>\] <command> \[<args>\]\n   or: git hop \[<options>\] <branch>\n   or: git hop \[<options>\] <uri> \[<path>\]\n\n'
stderr '^        --git-domain string '
! stderr '^Error:'

exec sh -c 'git-hop list --no-such-flag; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unknown flag: --no-such-flag$'
! stderr '^Error:'

# --- unknown shorthand ---
exec sh -c 'git-hop -x; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unknown shorthand flag: ''x'' in -x$'

exec sh -c 'git-hop status -Z; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unknown shorthand flag: ''Z'' in -Z\nusage: git hop status \[<options>\] \[target\]\n\n        --all   Show system-wide'
# Only the command's own options; global ones are one --help away.
! stderr '--porcelain'

# --- bad flag value ---
exec sh -c 'git-hop prune --dry-run=maybe; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: invalid argument "maybe" for "(-n, )?--dry-run" flag'

# repair --color takes git's always, auto or never, and nothing else.
exec sh -c 'git-hop repair -n --color=bogus; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: invalid argument "bogus" for "--color" flag: want always, auto or never'

# --- wrong positional count: too few, too many, out of range ---
exec sh -c 'git-hop add; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: requires a branch name, or --task <id> to derive one\nusage: git hop add \[<options>\] \[branch\]\n\n'
stderr '^        --task string '

exec sh -c 'git-hop add a b; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: accepts at most 1 arg\(s\), received 2$'

exec sh -c 'git-hop remove a b; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: accepts at most 1 arg\(s\), received 2$'

# remove takes a target or --merged: neither, or both, is a usage error.
exec sh -c 'git-hop remove; echo "exit=$?"'
stdout 'exit=129'
stderr '\Aerror: requires a target, or --merged\nusage: git hop remove \[<options>\] \[target\]\n\n'
stderr '^        --merged '
! stderr 'fatal:'

exec sh -c 'git-hop remove main --merged; echo "exit=$?"'
stdout 'exit=129'
stderr '\Aerror: cannot pass both a target and --merged\nusage: git hop remove '

exec sh -c 'git-hop remove --json; echo "exit=$?"'
stdout 'exit=129'
stderr '\A\{"level":"error","msg":"requires a target, or --merged"\}\n\z'

exec sh -c 'git-hop move; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: accepts between 1 and 2 arg\(s\), received 0$'

exec sh -c 'git-hop completion; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: accepts 1 arg\(s\), received 0$'

# An unsupported shell is refused, naming the ones that are supported.
exec sh -c 'git-hop completion bogus; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unsupported shell "bogus" \(valid: bash, zsh, fish\)$'
! stdout 'complete'

exec git-hop completion bash
stdout 'bash completion'

# A command that takes no operand refuses one rather than ignoring it.
exec sh -c 'git-hop list extra; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unknown command "extra" for "git-hop list"\nusage: git hop list\n\n\z'
! stdout 'Branch'

exec sh -c 'git-hop env start extra; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unknown command "extra" for "git-hop env start"$'

exec sh -c 'git-hop status a b; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: accepts at most 1 arg\(s\), received 2$'

# --- unknown subcommand under a command group ---
exec sh -c 'git-hop env bogus; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unknown command "bogus" for "git-hop env"\nusage: git hop env gc \[<options>\]\n   or: git hop env generate\n   or: git hop env start\n   or: git hop env stop\n'
! stdout 'Usage:'

exec sh -c 'git-hop upgrade bogus; echo "exit=$?"'
stdout 'exit=129'
stderr '^error: unknown command "bogus" for "git-hop upgrade"'

# --- machine output asked for: no usage block ---
# JSON mode reports the error as the JSON record operation failures emit.
exec sh -c 'git-hop list --json extra; echo "exit=$?"'
stdout 'exit=129'
stderr '\A\{"level":"error","msg":"unknown command \\"extra\\" for \\"git-hop list\\""\}\n\z'

# ...even when the output flag comes after the flag that failed to parse.
exec sh -c 'git-hop status -Z --porcelain; echo "exit=$?"'
stdout 'exit=129'
stderr '\Aerror: unknown shorthand flag: ''Z'' in -Z\n\z'

exec sh -c 'git-hop add --format=json; echo "exit=$?"'
stdout 'exit=129'
stderr '\A\{"level":"error","msg":"requires a branch name, or --task <id> to derive one"\}\n\z'

# Other machine formats keep the plain error line alone.
exec sh -c 'git-hop add --format=yaml; echo "exit=$?"'
stdout 'exit=129'
stderr '\Aerror: requires a branch name, or --task <id> to derive one\n\z'

# A human --format keeps the usage block.
exec sh -c 'git-hop status -Z --format=table; echo "exit=$?"'
stdout 'exit=129'
stderr '^usage: git hop status '

# A flag value is not a subcommand word.
exec sh -c 'git-hop env --config /dev/null --help; echo "exit=$?"'
stdout 'exit=0'

# Bare group and explicit help still show help and succeed.
exec git-hop env
stdout 'Usage:'
exec git-hop env --help
stdout 'Usage:'

# The rejected command ran nothing: no worktree was created.
! exists hops/a

# --- operation failures stay at 1 ---
exec sh -c 'git-hop remove no-such-worktree --no-prompt; echo "exit=$?"'
stdout 'exit=1'
stderr '^fatal: '

exec sh -c 'git-hop no-such-worktree; echo "exit=$?"'
stdout 'exit=1'
stderr '^fatal: '
