# `git hop init --force` converts a repository with uncommitted changes,
# for the bare layout as well as --regular. The dirty-tree refusal only
# suggests ways out that actually get past it.

# --- dirty repo: refused without --force, advice names only real exits ---
exec git init $WORK/dirty
cd $WORK/dirty
exec git commit --allow-empty -m 'initial'
cp $WORK/wip wip.txt
! exec git-hop init --no-prompt --no-hooks
stderr '^error: Repository has uncommitted changes$'
stderr '^hint: Then run: git hop init --no-prompt --no-hooks$'
stderr '^hint:   git hop init --no-prompt --force --no-hooks$'
! stderr 'regular'
exists $WORK/dirty/.git

# The advice repeats the flags given: after --regular, the commands it
# offers convert to the regular layout, not to bare.
! exec git-hop init --no-prompt --no-hooks --regular
stderr '^hint: Then run: git hop init --no-prompt --regular --no-hooks$'
stderr '^hint:   git hop init --no-prompt --regular --force --no-hooks$'

# --- --force: bare conversion goes through, the file moves to hops/main ---
exec git-hop init --no-prompt --no-hooks --force
stdout 'Conversion successful'
! exists $WORK/dirty/.git
exists $WORK/dirty/hops/main/wip.txt
exec git -C $WORK/dirty rev-parse --is-bare-repository
stdout '^true$'

# --- --force --regular: same outcome for the regular layout ---
exec git init $WORK/dirtyreg
cd $WORK/dirtyreg
exec git commit --allow-empty -m 'initial'
cp $WORK/wip wip.txt
exec git-hop init --no-prompt --no-hooks --regular --force
stdout 'Conversion successful'
exists $WORK/dirtyreg/wip.txt
exists $WORK/dirtyreg/hop.json

-- wip --
work in progress
