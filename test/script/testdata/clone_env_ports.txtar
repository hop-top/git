# clone prepares the environment of the worktree it creates as add does
# for its own: ports and volumes allocated and recorded in the hopspace,
# the worktree's .env, and a compose override that swaps the compose
# file's hardcoded host ports for the allocated ones. An env start there,
# automatic or by hand, then runs compose with the override and .env
# instead of the compose file's own ports.
#
# A stub docker on PATH stands in for compose: `compose config` fails (so
# the raw compose file is parsed) and each `up` is logged with its
# arguments and directory.

mkdir $WORK/bin
cp $WORK/docker-stub $WORK/bin/docker
chmod 755 $WORK/bin/docker
env PATH=$WORK/bin${:}$PATH

exec git init --bare $WORK/org/repo.git
exec git clone $WORK/org/repo.git $WORK/seed
cd $WORK/seed
cp $WORK/compose.yml docker-compose.yml
exec git add docker-compose.yml
exec git commit -m 'compose'
exec git push origin main
cd $WORK

# --- clone: the first worktree gets allocated ports and the override ---
exec git-hop $WORK/org/repo.git hub
! exists $WORK/up.log
grep '^HOP_PORT_WEB=[0-9]+$' $WORK/hub/hops/main/.env
! grep 'HOP_PORT_WEB=8080$' $WORK/hub/hops/main/.env
grep '"main"' $WORK/hub/ports.json
grep '"WEB": [0-9]+' $WORK/hub/ports.json
grep '"overrideDir": ".*/.cache/git-hop/org/repo/hub-[0-9a-f]{8}/main"' $WORK/hub/ports.json
exec sh -c 'cat $WORK/.cache/git-hop/org/repo/hub-*/main/docker-compose.override.yml'
stdout 'HOP_PORT_WEB'
! stdout '8080'

# --- env start in the cloned worktree runs compose with them ---
cd $WORK/hub/hops/main
exec git-hop env start
grep -count=1 '^up ' $WORK/up.log
grep '^up compose -p org-repo-main -f docker-compose.yml -f .*/org/repo/hub-[0-9a-f]{8}/main/docker-compose.override.yml --env-file .env up -d in .*/hub/hops/main$' $WORK/up.log
cd $WORK

# --- the automatic start after clone does too ---
exec git-hop $WORK/org/repo.git hub-auto --env-start
grep -count=2 '^up ' $WORK/up.log
grep '^up compose -p org-repo-main -f docker-compose.yml -f .*/org/repo/hub-auto-[0-9a-f]{8}/main/docker-compose.override.yml --env-file .env up -d in .*/hub-auto/hops/main$' $WORK/up.log
grep '^HOP_PORT_WEB=[0-9]+$' $WORK/hub-auto/hops/main/.env

-- compose.yml --
services:
  web:
    image: nginx
    ports:
      - "8080:80"
-- docker-stub --
#!/bin/sh
case " $* " in
*" up "*)
	echo "up $* in $PWD" >> "$WORK/up.log"
	exit 0
	;;
*" config "*)
	exit 1
	;;
esac
exit 0
