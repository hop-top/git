# clone links the shared dependencies of the worktree it creates, as add
# does, so a fresh hub is healthy: doctor reports no missing deps. The
# link lands before post-worktree-add (see setup_before_post_worktree_add)
# and clone publishes deps.installed for it.
#
# The regression this pins: clone never ran the deps set-up, so doctor
# reported "main: missing node_modules" right after every clone of a repo
# with a lockfile.
#
# A stub npm on PATH stands in for `npm ci`: it writes ./node_modules.

mkdir $WORK/bin
cp $WORK/npm-stub $WORK/bin/npm
chmod 755 $WORK/bin/npm
env PATH=$WORK/bin${:}$PATH

exec git init --bare $WORK/org/repo.git
exec git clone $WORK/org/repo.git $WORK/seed
cd $WORK/seed
cp $WORK/package.json package.json
cp $WORK/package.json package-lock.json
exec git add package.json package-lock.json
exec git commit -m 'npm'
exec git push origin main
cd $WORK

exec git config --global hop.events.sink jsonl
exec git config --global hop.events.path $WORK/events.jsonl

exec git-hop $WORK/org/repo.git hub
stdout 'Dependencies installed\.'
exec readlink $WORK/hub/hops/main/node_modules
stdout '/hub/deps/[0-9a-f]{6}/node_modules$'
exists $WORK/hub/hops/main/node_modules/installed
grep -count=1 '"topic":"git.runtime.deps.installed".*"payload":\{"worktree_path":"[^"]*/hub/hops/main","branch":"main"\}' $WORK/events.jsonl

cd $WORK/hub
exec git-hop doctor --json
decode json stdout '#' 0
exec git-hop doctor
! stderr 'missing node_modules'

-- package.json --
{}
-- npm-stub --
#!/bin/sh
mkdir -p node_modules && echo ok > node_modules/installed
